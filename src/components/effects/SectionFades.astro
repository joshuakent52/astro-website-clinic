---
/**
 * SectionFades
 * Drop this into any page (once) to give that page's top-level
 * <main id="main-content"> sections a subtle fade/slide transition:
 *  - the first section (expected to be the hero, class "hero") fades in
 *    once on load, since it's already visible above the fold
 *  - every other top-level section fades in as it scrolls into view,
 *    and fades back out if scrolled back out of view
 *
 * Renders no markup of its own — just scoped style/script tags — so it
 * can be dropped anywhere in a page's template. Astro only ships this
 * CSS/JS on pages that actually import and use this component.
 */
---

<style is:global>
  /* Hero fades in once, immediately on load, since it's visible above
     the fold before any scrolling happens. */
  main#main-content > section.hero {
    animation: home-fade-in 900ms var(--ease-standard) both;
  }

  /* Every other top-level section fades in as it scrolls into view, and
     fades back out if scrolled back out of view, via the .is-revealed
     class toggled in the script below. */
  main#main-content > section:not(.hero) {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 700ms var(--ease-standard),
      transform 700ms var(--ease-standard);
  }

  main#main-content > section:not(.hero).is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes home-fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* No-JS fallback: without the script to toggle .is-revealed, content
     must never be stuck invisible. */
  html:not(.js) main#main-content > section:not(.hero) {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    main#main-content > section {
      opacity: 1;
      transform: none;
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  // Marks JS as available so the no-JS CSS fallback above steps aside.
  document.documentElement.classList.add("js");

  const sections = document.querySelectorAll<HTMLElement>(
    "main#main-content > section:not(.hero)",
  );

  if (sections.length === 0) {
    // Nothing to observe.
  } else if (!("IntersectionObserver" in window)) {
    // Older browsers: just show everything, no fade.
    sections.forEach((section) => section.classList.add("is-revealed"));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          entry.target.classList.toggle("is-revealed", entry.isIntersecting);
        }
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -10% 0px",
      },
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>