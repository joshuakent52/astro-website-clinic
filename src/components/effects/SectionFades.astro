---
/**
 * SectionFades
 * Drop this into any page (once) to give that page's top-level
 * <main id="main-content"> sections a quick fade/slide transition:
 *  - only every OTHER top-level section fades (the 1nd, 3th, 5th...,
 *    e.g. hero stays put, the section after it fades, the one after
 *    that stays put, etc.) via :nth-of-type(odd)
 *  - those sections fade in as they scroll into view, and fade back
 *    out if scrolled back out of view
 *
 * Renders no markup of its own — just scoped style/script tags — so it
 * can be dropped anywhere in a page's template. Astro only ships this
 * CSS/JS on pages that actually import and use this component.
 */
---

<style is:global>
  /* Every other top-level section (2nd, 4th, 6th...) fades in as it
     scrolls into view, and fades back out if scrolled back out of
     view, via the .is-revealed class toggled in the script below. */
  main#main-content > section:nth-of-type(odd) {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 200ms var(--ease-standard),
      transform 200ms var(--ease-standard);
  }

  main#main-content > section:nth-of-type(odd).is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* No-JS fallback: without the script to toggle .is-revealed, content
     must never be stuck invisible. */
  html:not(.js) main#main-content > section:nth-of-type(odd) {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    main#main-content > section {
      opacity: 1;
      transform: none;
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  // Marks JS as available so the no-JS CSS fallback above steps aside.
  document.documentElement.classList.add("js");

  const sections = document.querySelectorAll<HTMLElement>(
    "main#main-content > section:nth-of-type(odd)",
  );

  if (sections.length === 0) {
    // Nothing to observe.
  } else if (!("IntersectionObserver" in window)) {
    // Older browsers: just show everything, no fade.
    sections.forEach((section) => section.classList.add("is-revealed"));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          entry.target.classList.toggle("is-revealed", entry.isIntersecting);
        }
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -10% 0px",
      },
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>