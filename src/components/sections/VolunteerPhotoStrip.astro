---
import Container from "../layout/Container.astro";
import type { VolunteerPhoto } from "../../data/volunteer";

/**
 * VolunteerPhotoStrip
 * A three-photo strip on a light-blue band: equal 4/3 photos with
 * rounded corners, side by side. Used on the volunteer page between
 * the "why volunteer" section and the apply section.
 */

interface Props {
  photos: VolunteerPhoto[];
}

const { photos } = Astro.props;
---

<section class="photo-strip" aria-label="Volunteer photos">
  <Container>
    <div class="photo-strip__grid">
      {photos.map((photo) => <img src={photo.src} alt={photo.alt} class="photo-strip__image" loading="lazy" />)}
    </div>
  </Container>
</section>

<style>
  .photo-strip {
    background-color: var(--color-secondary-light);
    padding-block: var(--space-lg);
  }

  .photo-strip__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .photo-strip__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
  }

  /* Breakpoint: md (768px) — matches the shared stacking breakpoint
     used elsewhere in the project. */
  @media (max-width: 768px) {
    .photo-strip__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
