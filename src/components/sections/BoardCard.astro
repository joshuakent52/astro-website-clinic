---
import type { BoardMember } from "../../data/board";

/**
 * BoardCard
 * A single board member's photo, name, and title, with a collapsible
 * bio underneath. Built on native <details>/<summary> so the toggle
 * works with no client-side JS and is keyboard/screen-reader
 * accessible by default. Open by default to match the reference design.
 */

interface Props {
  member: BoardMember;
}

const { member } = Astro.props;
const paragraphs = member.bio.split("\n").filter(Boolean);
---

<details class="board-card" open>
  <summary class="board-card__summary">
    <span class="board-card__photo-wrap">
      <img src={member.image} alt={member.name} class="board-card__photo" />
    </span>
    <span class="board-card__name">{member.name}</span>
    <span class="board-card__title">{member.title}</span>
    <span class="board-card__toggle">
      <span class="board-card__toggle-label board-card__toggle-label--show">Show Bio</span>
      <span class="board-card__toggle-label board-card__toggle-label--hide">Hide Bio</span>
      <svg class="board-card__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m6 9 6 6 6-6" />
      </svg>
    </span>
  </summary>

  <div class="board-card__bio">
    {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</details>

<style>
  .board-card {
    background-color: var(--color-surface-muted);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .board-card__summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-lg) var(--space-md) var(--space-md);
  }

  .board-card__summary::-webkit-details-marker {
    display: none;
  }

  .board-card__summary:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .board-card__photo-wrap {
    width: 8.5rem;
    height: 8.5rem;
    border-radius: var(--radius-full);
    overflow: hidden;
    margin-bottom: var(--space-md);
    box-shadow: var(--shadow-md);
    flex-shrink: 0;
  }

  .board-card__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .board-card__name {
    font-size: var(--font-size-h4);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
  }

  .board-card__title {
    color: var(--color-text-muted);
    margin-top: var(--space-3xs);
    margin-bottom: var(--space-md);
  }

  .board-card__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-semibold);
    padding: var(--space-2xs) var(--space-md);
    border-radius: var(--radius-full);
  }

  .board-card__toggle-label--hide {
    display: none;
  }

  .board-card[open] .board-card__toggle-label--show {
    display: none;
  }

  .board-card[open] .board-card__toggle-label--hide {
    display: inline;
  }

  .board-card__chevron {
    width: 1rem;
    height: 1rem;
    transition: transform 0.2s ease;
  }

  .board-card[open] .board-card__chevron {
    transform: rotate(180deg);
  }

  .board-card__bio {
    background-color: var(--color-primary-dark);
    color: var(--color-text-inverse);
    padding: var(--space-lg) var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .board-card__bio p {
    margin: 0;
    font-size: var(--font-size-small);
    line-height: var(--line-height-body);
  }
</style>
