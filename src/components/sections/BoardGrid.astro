---
import Section from "../ui/Section.astro";
import BoardCard from "./BoardCard.astro";
import type { BoardMember } from "../../data/board";

/**
 * BoardGrid
 * Responsive grid of BoardCard members — 4 columns on desktop, 2 on
 * tablet, 1 on mobile.
 *
 * Members whose `image` is still a placeholder (e.g.
 * "/images/placeholder.png") are skipped entirely — no card, photo,
 * name, or bio/role text is rendered for them — until a real photo is
 * added to their entry in the data file.
 */

interface Props {
  members: BoardMember[];
}

const { members } = Astro.props;
const membersWithPhoto = members.filter(
  (member) => member.image && !member.image.toLowerCase().includes("placeholder")
);
---

<Section>
  <div class="board-grid">
    {[...membersWithPhoto].map((member) => (
      <BoardCard member={member} />
    ))}
  </div>
</Section>

<style>
  .board-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
    align-items: start;
  }

  @media (max-width: 900px) {
    .board-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .board-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
