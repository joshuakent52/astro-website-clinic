---
import Section from "../ui/Section.astro";
import type { EligibilityRow } from "../../data/home";

/**
 * Eligibility
 * Two-column criteria + income-table layout, plus a full-width note
 * banner beneath it. Renders as two stacked sections so the note can be
 * full-bleed with a different background than the table above it.
 */

interface Props {
  heading: string;
  subheading: string;
  criteria: string[];
  tableCaption: string;
  tableColumns: string[];
  tableRows: EligibilityRow[];
  noteText: string;
  policyLinkText: string;
  policyLinkHref: string;
}

const {
  heading,
  subheading,
  criteria,
  tableCaption,
  tableColumns,
  tableRows,
  noteText,
  policyLinkText,
  policyLinkHref,
} = Astro.props;
---

<Section background="default">
  <div class="eligibility__intro">
    <h2>{heading}</h2>
    <p class="text-muted">{subheading}</p>
  </div>

  <div class="eligibility__grid">
    <ol class="eligibility__criteria">
      {
        criteria.map((item, index) => (
          <li>
            <span class="eligibility__number" aria-hidden="true">
              {index + 1}
            </span>
            <p>{item}</p>
          </li>
        ))
      }
    </ol>

    <div class="eligibility__table-wrap">
      <p class="eligibility__caption">{tableCaption}</p>
      <div class="eligibility__table-scroll">
        <table class="eligibility__table">
          <thead>
            <tr>
              {tableColumns.map((col) => <th scope="col">{col}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              tableRows.map((row) => (
                <tr>
                  <th scope="row">{row.size}</th>
                  <td>{row.annual}</td>
                  <td>{row.monthly}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Section>

<Section background="primary" spacing="tight">
  <p class="eligibility__note">
    {noteText} <a href={policyLinkHref}>{policyLinkText}</a>
  </p>
</Section>

<style>
  .eligibility__intro {
    text-align: center;
    max-width: var(--container-narrow-width);
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .eligibility__intro h2 {
    margin-bottom: var(--space-sm);
  }

  .eligibility__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: var(--space-2xl);
    align-items: start;
  }

  .eligibility__criteria {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .eligibility__criteria li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .eligibility__number {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold);
  }

  .eligibility__caption {
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-semibold);
    text-align: center;
    padding: var(--space-xs);
    background-color: var(--color-surface-muted);
    border: 1px solid var(--color-border);
    border-bottom: none;
  }

  .eligibility__table-scroll {
    overflow-x: auto;
  }

  .eligibility__table {
    width: 100%;
    min-width: 28rem;
    border: 1px solid var(--color-border);
    border-top: none;
  }

  .eligibility__table th,
  .eligibility__table td {
    padding: var(--space-2xs) var(--space-sm);
    text-align: center;
    font-size: var(--font-size-small);
    border-bottom: 1px solid var(--color-border);
  }

  .eligibility__table thead th {
    font-weight: var(--font-weight-semibold);
    background-color: var(--color-surface-muted);
  }

  .eligibility__table tbody th {
    font-weight: var(--font-weight-medium);
  }

  .eligibility__table tbody tr:last-child th,
  .eligibility__table tbody tr:last-child td {
    border-bottom: none;
  }

  .eligibility__note {
    text-align: center;
    max-width: var(--container-narrow-width);
    margin-inline: auto;
  }

  .eligibility__note a {
    color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .eligibility__grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
</style>
