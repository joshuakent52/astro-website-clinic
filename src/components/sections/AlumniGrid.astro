---
import Section from "../ui/Section.astro";

/**
 * AlumniGrid
 * Simple heading + grid of past member name/title chips, used at the
 * bottom of team roster pages (Clinic Leadership, Key Contributors) to
 * honor former members without the full photo/bio treatment used for
 * current members. Pairs with BoardGrid, which renders the current
 * roster above it.
 */

export interface AlumniMember {
  name: string;
  title: string;
}

interface Props {
  heading: string;
  alumni: AlumniMember[];
}

const { heading, alumni } = Astro.props;
---

<Section background="muted">
  <h2 class="alumni-grid__heading">{heading}</h2>
  <div class="alumni-grid">
    {alumni.map((person) => (
      <div class="alumni-card">
        <span class="alumni-card__name">{person.name}</span>
        <span class="alumni-card__title">{person.title}</span>
      </div>
    ))}
  </div>
</Section>

<style>
  .alumni-grid__heading {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .alumni-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-md);
  }

  @media (max-width: 900px) {
    .alumni-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .alumni-grid {
      grid-template-columns: 1fr;
    }
  }

  .alumni-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3xs);
  }

  .alumni-card__name {
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
  }

  .alumni-card__title {
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
  }
</style>
