---
import Section from "../ui/Section.astro";
import type { ServiceItem } from "../../data/about";

/**
 * ServicesOverview
 * A grid of four service overview boxes (Medical Care, Pharmacy, Lab,
 * Dental Suite): each is a background photo with a blue tint wash and
 * white title/description text on top, formatted similarly to the
 * class cards on the classes page. Used on the about page beneath the
 * hero banner.
 */

interface Props {
  heading?: string;
  items: ServiceItem[];
}

const { heading, items } = Astro.props;
---

<Section background="surface">
  {heading && <h2 class="services__heading">{heading}</h2>}
  <ul class="services-grid">
    {
      items.map((item) => (
        <li class="service-card">
          <img src={item.image} alt="" class="service-card__image" />
          <div class="service-card__overlay" aria-hidden="true" />
          <div class="service-card__content">
            <h3 class="service-card__title">{item.title}</h3>
            <p class="service-card__description">{item.description}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .services__heading {
    margin: 0 0 var(--space-lg);
    text-align: center;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .service-card {
    position: relative;
    display: flex;
    align-items: flex-end;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .service-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Blue tint wash over every service photo, matching the class cards
     on the classes page. */
  .service-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(2, 65, 107, 0.55) 0%,
      rgba(2, 65, 107, 0.35) 45%,
      rgba(1, 44, 73, 0.85) 100%
    );
  }

  .service-card__content {
    position: relative;
    z-index: 1;
    padding: var(--space-md);
    color: var(--color-text-inverse);
  }

  .service-card__title {
    font-size: var(--font-size-h4);
    line-height: var(--line-height-heading);
    margin: 0 0 var(--space-2xs);
  }

  .service-card__description {
    font-size: var(--font-size-small, var(--font-size-body));
    line-height: var(--line-height-body);
    margin: 0;
  }

  /* Breakpoint: md (768px) — matches the shared stacking breakpoint
     used elsewhere in the project. */
  @media (max-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr;
    }

    .service-card {
      aspect-ratio: 4 / 3;
    }
  }
</style>