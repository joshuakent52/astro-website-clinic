---
import Section from "../ui/Section.astro";
import type { ServiceItem } from "../../data/about";

/**
 * ServicesOverview
 * A stacked list of four service rows (Medical Care, Pharmacy, Lab,
 * Dental): each row joins a photo and a solid-blue text box side by
 * side (50/50, image left) with no gap between them. Used on the about
 * page beneath the hero banner.
 */

interface Props {
  heading?: string;
  items: ServiceItem[];
}

const { heading, items } = Astro.props;
---

<Section background="surface">
  {heading && <h2 class="services__heading">{heading}</h2>}
  <ul class="services-grid">
    {
      items.map((item) => (
        <li class="service-card">
          <img src={item.image} alt={item.title} class="service-card__image" loading="lazy" />
          <div class="service-card__body">
            <h3 class="service-card__title">{item.title}</h3>
            <p class="service-card__description">{item.description}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .services__heading {
    margin: 0 0 var(--space-lg);
    text-align: center;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .service-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    min-height: 18rem;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
    box-shadow: var(--shadow-md);
  }

  .service-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .service-card__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: var(--space-2xs);
    text-align: left;
    padding: var(--space-lg) var(--space-xl);
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
  }

  .service-card__title {
    font-size: var(--font-size-h4);
    line-height: var(--line-height-heading);
    color: var(--color-text-inverse);
    margin: 0;
  }

  /* Global `p` sets dark text; override so descriptions stay white. */
  .service-card__description {
    font-size: var(--font-size-small, var(--font-size-body));
    line-height: var(--line-height-body);
    color: var(--color-text-inverse);
    margin: 0;
  }

  /* Breakpoint: md (768px) — matches the shared stacking breakpoint
     used elsewhere in the project. */
  @media (max-width: 768px) {
    .service-card {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .service-card__image {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }
</style>
