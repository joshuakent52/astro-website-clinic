---
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";

/**
 * VolunteerPortalBanner
 * Compact light-blue banner for current volunteers linking to the external
 * volunteer portal. Uses the secondary-light section band with dark
 * primary-dark text (muted/white fail contrast on this background).
 * Keeps height minimal with tight spacing.
 */

interface Props {
  heading: string;
  subheading: string;
  ctaText: string;
  ctaHref: string;
}

const { heading, subheading, ctaText, ctaHref } = Astro.props;
---

<Section background="secondary-light" spacing="tight">
  <div class="portal-banner">
    <h2 class="portal-banner__heading">{heading}</h2>
    <p class="portal-banner__subheading">{subheading}</p>
    <Button text={ctaText} href={ctaHref} variant="primary" external />
  </div>
</Section>

<style>
  .portal-banner {
    text-align: center;
    max-width: var(--container-narrow-width);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .portal-banner__heading {
    margin: 0;
    color: var(--color-primary-dark);
  }

  .portal-banner__subheading {
    margin: 0;
    color: var(--color-primary-dark);
  }
</style>
