---
import Container from "../layout/Container.astro";

/**
 * DonateHero
 * Photo-backed intro banner for the donate page: a large heading on one
 * side and a testimonial-style quote card on the other. Follows the same
 * full-bleed image + overlay pattern as `Hero` so text stays readable
 * over the photo.
 */

interface Props {
  backgroundImage: string;
  heading: string;
  quote: {
    text: string;
    author: string;
  };
}

const { backgroundImage, heading, quote } = Astro.props;

// The quote is written as separate paragraphs in the data file,
// separated by newlines.
const paragraphs = quote.text.split("\n").filter(Boolean);
---

<section class="donate-hero">
  <img src={backgroundImage} alt="" class="donate-hero__bg" />
  <div class="donate-hero__overlay" aria-hidden="true"></div>
  <Container>
    <div class="donate-hero__inner">
      <h1 class="donate-hero__heading">{heading}</h1>

      <figure class="donate-hero__quote">
        <blockquote>
          {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </blockquote>
        <figcaption>— {quote.author}</figcaption>
      </figure>
    </div>
  </Container>
</section>

<style>
  .donate-hero {
    position: relative;
    overflow: hidden;
    color: var(--color-text-inverse);
    background-color: var(--color-primary);
  }

  .donate-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .donate-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(1, 44, 73, 0.82) 0%,
      rgba(2, 65, 107, 0.68) 55%,
      rgba(2, 65, 107, 0.45) 100%
    );
  }

  .donate-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--space-2xl);
    align-items: center;
    padding-block: calc(var(--space-section) * 0.6);
  }

  .donate-hero__heading {
    color: var(--color-text-inverse);
  }

  .donate-hero__quote {
    background-color: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: var(--space-lg) var(--space-xl);
  }

  .donate-hero__quote blockquote {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    font-style: italic;
    color: var(--color-text-muted);
  }

  .donate-hero__quote figcaption {
    margin-top: var(--space-md);
    font-style: italic;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  /* Breakpoint: md (768px) — matches the stacking breakpoint used
     elsewhere in the project. */
  @media (max-width: 768px) {
    .donate-hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .donate-hero__quote {
      padding: var(--space-lg);
    }
  }
</style>
