---
import Container from "../layout/Container.astro";

/**
 * DonateHero
 * Photo-backed intro banner for the donate page: a large heading on one
 * side and a testimonial-style quote on the other. Follows the same
 * full-bleed image + overlay pattern as `Hero` so text stays readable
 * over the photo. The quote is transparent text (no card) styled like
 * the `Hero` subheading, kept italic to mark it as a quotation.
 */

interface Props {
  backgroundImage: string;
  heading: string;
  quote: {
    text: string;
    author: string;
  };
}

const { backgroundImage, heading, quote } = Astro.props;

// The quote is written as separate paragraphs in the data file,
// separated by newlines.
const paragraphs = quote.text.split("\n").filter(Boolean);
---

<section class="donate-hero">
  <img src={backgroundImage} alt="" class="donate-hero__bg" />
  <div class="donate-hero__overlay" aria-hidden="true"></div>
  <Container>
    <div class="donate-hero__inner">
      <h1 class="donate-hero__heading">{heading}</h1>

      <figure class="donate-hero__quote">
        <blockquote>
          {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </blockquote>
        <figcaption>— {quote.author}</figcaption>
      </figure>
    </div>
  </Container>
</section>

<style>
  .donate-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--hero-min-height);
    overflow: hidden;
    color: var(--color-text-inverse);
    background-color: var(--color-primary);
  }

  .donate-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .donate-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(1, 44, 73, 0.82) 0%,
      rgba(2, 65, 107, 0.68) 55%,
      rgba(2, 65, 107, 0.45) 100%
    );
  }

  .donate-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--space-2xl);
    align-items: center;
    padding-block: var(--space-2xl);
  }

  .donate-hero__heading {
    color: var(--color-text-inverse);
  }

  .donate-hero__quote {
    margin: 0;
    padding: 0;
    background: transparent;
    border: 0;
    box-shadow: none;
  }

  .donate-hero__quote blockquote {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin: 0;
    font-size: var(--font-size-h4);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-heading);
    font-style: italic;
    color: var(--color-text-inverse);
  }

  /* Global `p` sets dark text; override so quote paragraphs stay white. */
  .donate-hero__quote blockquote p {
    margin: 0;
    color: var(--color-text-inverse);
  }

  .donate-hero__quote figcaption {
    margin-top: var(--space-md);
    margin-bottom: 0;
    font-size: var(--font-size-body);
    font-style: italic;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-inverse);
  }

  /* Breakpoint: md (768px) — matches the stacking breakpoint used
     elsewhere in the project. Min-height mirrors Hero since vars
     aren't usable inside media queries. */
  @media (max-width: 768px) {
    .donate-hero {
      min-height: clamp(24rem, 90vw, 34rem);
    }

    .donate-hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
      padding-block: var(--space-xl);
    }
  }
</style>
