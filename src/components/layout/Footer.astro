---
import Container from "./Container.astro";
import type { NavItem } from "../../types";
import { siteName } from "../../config/site";
import {
  mapEmbedSrc,
  contact,
  services,
  socialLinks,
  tagline,
  closures,
  type SocialIcon,
} from "../../config/footer";

/**
 * Footer
 *
 * Layout:
 * - Desktop (>=768px): 5 columns — map, contact info, upcoming closures,
 *   quick links, our services — plus a bottom bar.
 * - Mobile (<768px): map + contact info + upcoming closures only (quick
 *   links / services are dropped to keep the mobile footer short),
 *   followed by the same bottom bar.
 *
 * All copy (address, hours, phone, email, services, socials, closures)
 * lives in `src/config/footer.ts` — nothing footer-specific is
 * hardcoded here. See that file for how the closures list works.
 */

interface Props {
  navItems?: NavItem[];
}

const { navItems = [] } = Astro.props;
const year = new Date().getFullYear();

// Sort closures chronologically; the exact list shown then updates
// automatically (see the inline script below and config/footer.ts).
const sortedClosures = [...closures].sort((a, b) => a.date.localeCompare(b.date));

function formatClosureDate(iso: string): string {
  const [y, m, d] = iso.split("-").map(Number);
  const date = new Date(y, m - 1, d);
  const month = date.toLocaleString("en-US", { month: "long" });
  const suffix =
    d % 10 === 1 && d !== 11
      ? "st"
      : d % 10 === 2 && d !== 12
        ? "nd"
        : d % 10 === 3 && d !== 13
          ? "rd"
          : "th";
  return `${month} ${d}${suffix}`;
}

// Build-time default (so the page is correct even with JS disabled):
// whichever 5 entries are upcoming as of build. The client script below
// re-checks against the visitor's actual clock on every page load, so
// the list keeps advancing on its own between deploys as dates pass.
const todayIso = new Date().toISOString().slice(0, 10);
const defaultVisibleDates = new Set(
  sortedClosures.filter((c) => c.date >= todayIso).slice(0, 5).map((c) => c.date)
);

const icons: Record<SocialIcon, string> = {
  instagram: `<path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.9.2 2.3.4.6.2 1 .5 1.4.9.4.4.7.9.9 1.4.2.4.3 1 .4 2.3.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.9-.4 2.3-.2.6-.5 1-.9 1.4-.4.4-.9.7-1.4.9-.4.2-1 .3-2.3.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.9-.2-2.3-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.9-.9-1.4-.2-.4-.3-1-.4-2.3C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.2-1.9.4-2.3.2-.6.5-1 .9-1.4.4-.4.9-.7 1.4-.9.4-.2 1-.3 2.3-.4C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.1 0-3.5 0-4.7.1-1 .1-1.6.2-1.9.3-.5.2-.8.4-1.2.8-.4.4-.6.7-.8 1.2-.1.3-.3.9-.3 1.9C3 9.5 3 9.9 3 12s0 3.5.1 4.7c.1 1 .2 1.6.3 1.9.2.5.4.8.8 1.2.4.4.7.6 1.2.8.3.1.9.3 1.9.3 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1-.1 1.6-.2 1.9-.3.5-.2.8-.4 1.2-.8.4-.4.6-.7.8-1.2.1-.3.3-.9.3-1.9.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c-.1-1-.2-1.6-.3-1.9-.2-.5-.4-.8-.8-1.2-.4-.4-.7-.6-1.2-.8-.3-.1-.9-.3-1.9-.3-1.2-.1-1.6-.1-4.7-.1zm0 3.6a4.4 4.4 0 1 1 0 8.8 4.4 4.4 0 0 1 0-8.8zm0 1.8a2.6 2.6 0 1 0 0 5.2 2.6 2.6 0 0 0 0-5.2zm4.6-2a1 1 0 1 1 0 2.1 1 1 0 0 1 0-2.1z"/>`,
  linkedin: `<path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM10 9h3.8v1.7h.1c.5-1 1.9-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.6c0-1.3 0-3-1.9-3s-2.2 1.4-2.2 2.9V21h-4z"/>`,
  facebook: `<path d="M13.5 21v-8.1h2.7l.4-3.2h-3.1V7.6c0-.9.3-1.6 1.6-1.6h1.7V3.1C16.5 3 15.5 3 14.3 3c-2.6 0-4.4 1.6-4.4 4.5v2.2H7.2v3.2h2.7V21z"/>`,
};
---

<footer class="site-footer">
  <Container>
    <div class="site-footer__main">
      <div class="site-footer__col site-footer__col--map">
        <iframe
          class="site-footer__map"
          src={mapEmbedSrc}
          width="100%"
          height="160"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Map to ${siteName}`}
        ></iframe>
      </div>

      <div class="site-footer__col site-footer__col--contact">
        <p class="site-footer__address">
          {contact.addressLines.map((line) => <>{line}<br /></>)}
        </p>

        <p class="site-footer__hours">
          {
            contact.hours.map((row) => (
              <span class="site-footer__hours-row">
                <span>{row.days}</span>
                <span>{row.time}</span>
              </span>
            ))
          }
        </p>

        <p>
          <a class="site-footer__link" href={contact.phoneHref}>{contact.phone}</a>
        </p>
        <p>
          <a class="site-footer__link" href={`mailto:${contact.email}`}>{contact.email}</a>
        </p>
      </div>

      <div class="site-footer__col site-footer__col--closures">
        <h3 class="site-footer__heading">Upcoming Closures</h3>
        <ul class="site-footer__closures-list" data-closures-list>
          {
            sortedClosures.map((closure) => (
              <li
                data-date={closure.date}
                style={defaultVisibleDates.has(closure.date) ? undefined : "display:none"}
              >
                {formatClosureDate(closure.date)}
              </li>
            ))
          }
          <li class="site-footer__closures-empty" data-empty style="display:none">
            No upcoming closures scheduled
          </li>
        </ul>
      </div>

      {
        navItems.length > 0 && (
          <nav class="site-footer__col site-footer__col--links" aria-label="Footer">
            <h3 class="site-footer__heading">Quick Links</h3>
            <ul>
              {navItems.map((item) => (
                <li>
                  <a class="site-footer__link" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        services.length > 0 && (
          <nav class="site-footer__col site-footer__col--services" aria-label="Our Services">
            <h3 class="site-footer__heading">Our Services</h3>
            <ul>
              {services.map((item) => (
                <li>
                  <a class="site-footer__link" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>

    <div class="site-footer__bottom">
      <p class="text-small">
        &copy; {year} {siteName}. 501(c)(3). All rights reserved.
      </p>

      {
        socialLinks.length > 0 && (
          <ul class="site-footer__social">
            {socialLinks.map((social) => (
              <li>
                <a href={social.href} aria-label={social.label}>
                  <svg
                    viewBox="0 0 24 24"
                    width="16"
                    height="16"
                    fill="currentColor"
                    aria-hidden="true"
                    set:html={icons[social.icon]}
                  />
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <p class="text-small">{tagline}</p>
    </div>
  </Container>
</footer>

<script>
  // Keeps the "Upcoming Closures" list correct between deploys: on every
  // page load, re-checks each closure's date against the visitor's
  // clock and shows only the next 5 that haven't passed yet. The
  // server-rendered markup above already sorts closures oldest-first,
  // so this only needs to hide/show — no formatting or sorting here.
  const list = document.querySelector<HTMLUListElement>("[data-closures-list]");
  if (list) {
    const todayIso = new Date().toISOString().slice(0, 10);
    const items = Array.from(list.querySelectorAll<HTMLLIElement>("li[data-date]"));
    let shown = 0;
    for (const item of items) {
      const date = item.dataset.date;
      const isUpcoming = !!date && date >= todayIso;
      if (isUpcoming && shown < 5) {
        item.style.display = "";
        shown++;
      } else {
        item.style.display = "none";
      }
    }
    const empty = list.querySelector<HTMLLIElement>("[data-empty]");
    if (empty) empty.style.display = shown === 0 ? "" : "none";
  }
</script>

<style>
  .site-footer {
    background-color: var(--color-primary-dark);
    color: var(--color-text-inverse);
  }

  .site-footer__heading {
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-sm);
  }

  .site-footer__link {
    color: var(--color-text-inverse);
    text-decoration: none;
  }

  .site-footer__link:hover,
  .site-footer__link:focus-visible {
    text-decoration: underline;
  }

  /* ---------------------------------------------------------------- */
  /* Main row: map | contact | closures | quick links | services       */
  /* ---------------------------------------------------------------- */

  .site-footer__main {
    display: grid;
    grid-template-columns: minmax(180px, 260px) minmax(200px, 1fr) minmax(170px, 1fr) minmax(140px, 1fr) minmax(160px, 1fr);
    gap: var(--space-lg);
    padding-block: var(--space-xl);
  }

  .site-footer__col {
    min-width: 0;
  }

  .site-footer__col + .site-footer__col {
    border-left: 1px solid rgba(255, 255, 255, 0.2);
    padding-left: var(--space-lg);
  }

  .site-footer__map {
    display: block;
    width: 100%;
    height: 160px;
    border-radius: var(--radius-md);
  }

  .site-footer__address {
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-sm);
  }

  .site-footer__hours {
    margin-bottom: var(--space-sm);
  }

  .site-footer__hours-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    font-weight: var(--font-weight-semibold);
  }

  .site-footer__col--closures ul,
  .site-footer__col--links ul,
  .site-footer__col--services ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .site-footer__closures-empty {
    color: var(--color-secondary-light);
    font-style: italic;
  }

  /* ---------------------------------------------------------------- */
  /* Bottom bar                                                         */
  /* ---------------------------------------------------------------- */

  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    text-align: center;
    padding-block: var(--space-lg);
    background-color: var(--color-secondary-dark);
    margin-inline: calc(var(--container-padding-inline) * -1);
    padding-inline: var(--container-padding-inline);
  }

  .site-footer__social {
    display: flex;
    gap: var(--space-sm);
  }

  .site-footer__social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background-color: rgba(255, 255, 255, 0.15);
    color: var(--color-text-inverse);
    transition: background-color var(--transition-fast);
  }

  .site-footer__social a:hover,
  .site-footer__social a:focus-visible {
    background-color: rgba(255, 255, 255, 0.3);
  }

  /* ---------------------------------------------------------------- */
  /* Mobile (md: 768px) — map + contact + closures only, stacked;      */
  /* quick links and services are dropped, bottom bar stays.           */
  /* ---------------------------------------------------------------- */

  @media (max-width: 768px) {
    .site-footer__main {
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
      padding-block: var(--space-lg);
    }

    .site-footer__col + .site-footer__col {
      border-left: none;
      padding-left: 0;
    }

    .site-footer__col--links,
    .site-footer__col--services {
      display: none;
    }

    .site-footer__bottom {
      margin-inline: calc(var(--container-padding-inline) * -1);
    }
  }
</style>
