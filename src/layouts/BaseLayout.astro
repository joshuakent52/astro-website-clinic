---
import "../styles/global.css";
import "../styles/components.css";
import ClinicSchema from "../components/seo/ClinicSchema.astro";
import { defaultOgImage } from "../config/site";
import type { SeoProps } from "../types";

/**
 * BaseLayout
 * Shared document shell for every page: <head> metadata, skip link,
 * and the surrounding <html>/<body> structure. Page-specific metadata
 * is passed in via props rather than hardcoded here.
 */

interface Props extends SeoProps {
  /** Site name appended to every page title, e.g. "Page Title | Site Name". */
  siteName?: string;
  /** BCP 47 language code for the <html lang> attribute. */
  lang?: string;
}

const {
  title,
  description,
  canonicalUrl,
  ogImage,
  ogType = "website",
  robots,
  siteName = "Site Name",
  lang = "en",
} = Astro.props;

const pageTitle = title ? `${title} | ${siteName}` : siteName;

/**
 * Canonical URL: explicit `canonicalUrl` prop wins, otherwise derived
 * from the site origin + current path so every page is self-canonical
 * by default. Paths are normalized to the trailing-slash form Astro
 * emits for directory routes (e.g. /about/), so /about and /about/
 * never compete as duplicates.
 */
function defaultCanonical(): string | undefined {
  if (!Astro.site) return undefined;
  let path = Astro.url.pathname.replace(/\/index\.html$/, "/");
  if (!path.endsWith("/") && !path.split("/").pop()?.includes(".")) {
    path += "/";
  }
  return new URL(path, Astro.site).toString();
}

const resolvedCanonical = canonicalUrl ?? defaultCanonical();

/**
 * Share image: explicit `ogImage` prop wins, otherwise the site-wide
 * default from config/site.ts (made absolute). Dimensions/alt are
 * only known for the default, so they're emitted only in that case.
 */
const defaultOgImageUrl = Astro.site
  ? new URL(defaultOgImage.src, Astro.site).toString()
  : defaultOgImage.src;
const resolvedOgImage = ogImage ?? defaultOgImageUrl;
const isDefaultOgImage = resolvedOgImage === defaultOgImageUrl;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {resolvedCanonical && <link rel="canonical" href={resolvedCanonical} />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {resolvedCanonical && <meta property="og:url" content={resolvedCanonical} />}
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    {isDefaultOgImage && (
      <>
        <meta property="og:image:width" content={String(defaultOgImage.width)} />
        <meta property="og:image:height" content={String(defaultOgImage.height)} />
        <meta property="og:image:alt" content={defaultOgImage.alt} />
      </>
    )}
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content={resolvedOgImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />

    <!-- Preload primary body font weight to avoid layout shift -->
    <link rel="preload" href="/fonts/barlow-400.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Sitewide MedicalClinic + WebSite structured data -->
    <ClinicSchema />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <slot name="header" />
    <main id="main-content">
      <slot />
    </main>
    <slot name="footer" />

    <!--
      Vercel Web Analytics: cookieless, no personal data collected, no
      consent banner needed. Only does anything once Analytics is
      enabled for this project in the Vercel dashboard, and only
      reports data from the deployed (production/preview) site — it's
      inert during local `astro dev`.
    -->
    <script>
      import { inject } from "@vercel/analytics";
      inject();
    </script>
  </body>
</html>