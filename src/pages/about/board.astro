---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import Section from "../../components/ui/Section.astro";
import Button from "../../components/ui/Button.astro";

import { siteName, siteDescription, logo, flat_logo, navItems } from "../../config/site";

/**
 * Meet the Board page.
 * Placeholder only — board member profiles aren't ready yet.
 */
---

<BaseLayout
  title="Meet the Board"
  description="Meet the volunteer board of Bingham Family Clinic."
  siteName={siteName}
>
  <Header navItems={navItems} slot="header">
    <a slot="logo" href="/" aria-label={`${siteName} home`}>
      <img src={flat_logo.src} alt={flat_logo.alt} class="site-logo" />
    </a>
  </Header>

  <Section narrow>
    <div class="board-page">
      <h1>Meet the Board</h1>
      <p class="text-muted">
        This page is under construction — check back soon to meet the
        volunteer board members who guide Bingham Family Clinic's mission.
      </p>

      <div class="board-page__actions">
        <Button text="Back to About" href="/about" variant="outline" />
      </div>
    </div>
  </Section>

  <Footer navItems={navItems} slot="footer" />
</BaseLayout>

<style>
  .site-logo {
    height: 5rem;
    width: auto;
  }

  .board-page {
    text-align: center;
  }

  .board-page h1 {
    margin-bottom: var(--space-md);
  }

  .board-page__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }
</style>
