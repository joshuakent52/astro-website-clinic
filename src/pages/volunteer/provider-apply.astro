---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import Section from "../../components/ui/Section.astro";
import MicrosoftForm from "../../components/forms/MicrosoftForm.astro";

import { siteName, siteDescription, logo, flat_logo, navItems } from "../../config/site";

/**
 * Provider application page.
 * Embeds the live Microsoft Forms provider application via
 * MicrosoftForm.astro. Update `formSrc` here if the form URL ever
 * changes.
 */

const formSrc =
  "https://forms.office.com/Pages/ResponsePage.aspx?id=DRmRVUUIWkeAMQiyXuVHqfp2Q8H7zqZNubMrkHdQwiJUQjAzSlVXWUgzTTFSV0JDQlFSVE1GTTFETy4u&embed=true";
---

<BaseLayout
  title="Provider Application"
  description="Apply to volunteer as a clinical provider with Bingham Family Clinic."
  siteName={siteName}
>
  <Header navItems={navItems} slot="header">
    <a slot="logo" href="/" aria-label={`${siteName} home`}>
      <img src={flat_logo.src} alt={flat_logo.alt} class="site-logo" />
    </a>
  </Header>

  <Section narrow>
    <div class="apply-page">
      <h1>Provider Application</h1>
      <p class="text-muted">
        Fill out the form below to apply to volunteer as a clinical provider
        with Bingham Family Clinic.
      </p>
    </div>

    <MicrosoftForm src={formSrc} title="Provider Application" aspectRatio={500} />
  </Section>

  <Footer navItems={navItems} slot="footer" />
</BaseLayout>

<style>
  .site-logo {
    height: 5rem;
    width: auto;
  }

  .apply-page {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .apply-page h1 {
    margin-bottom: var(--space-md);
  }
</style>