---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import RolesGrid from "../../components/sections/RolesGrid.astro";

import { siteName, siteDescription, logo, flat_logo, navItems } from "../../config/site";
import { volunteerRoles } from "../../data/volunteer-roles";
---

<BaseLayout
  title="Volunteer Roles"
  description="Learn about the volunteer roles at Bingham Family Clinic — Orem, UT"
  siteName={siteName}
>
  <Header navItems={navItems} slot="header">
    <a slot="logo" href="/" aria-label={`${siteName} home`}>
      <img src={flat_logo.src} alt={flat_logo.alt} class="site-logo" />
    </a>
  </Header>

  <RolesGrid items={volunteerRoles} />

  <Footer navItems={navItems} slot="footer" />
</BaseLayout>

<style>
  .site-logo {
    height: 5rem;
    width: auto;
  }
</style>