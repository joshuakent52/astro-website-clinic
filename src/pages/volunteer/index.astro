---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import Hero from "../../components/sections/Hero.astro";
import VolunteerWhy from "../../components/sections/VolunteerWhy.astro";
import ApplySplit from "../../components/sections/ApplySplit.astro";
import Testimonials from "../../components/sections/Testimonials.astro";

import { siteName, siteDescription, logo, flat_logo, navItems } from "../../config/site";
import { hero, why, apply, testimonials } from "../../data/volunteer";
---

<BaseLayout
  title="Volunteer at Our Free Clinic"
  description="Volunteer with Bingham Family Clinic in Orem, UT — join our team as a volunteer or clinical provider helping Utah County families get free care."
  siteName={siteName}
>
  <Header navItems={navItems} slot="header">
    <a slot="logo" href="/" aria-label={`${siteName} home`}>
      <img src={flat_logo.src} alt={flat_logo.alt} class="site-logo" />
    </a>
  </Header>

  <Hero
    backgroundImage={hero.backgroundImage}
    heading={hero.heading}
    subheading={hero.subheading}
  />

  <VolunteerWhy
    image={why.image}
    heading={why.heading}
    benefits={why.benefits}
    ctaText={why.ctaText}
    ctaHref={why.ctaHref}
  />

  <ApplySplit heading={apply.heading} subheading={apply.subheading} options={apply.options} />

  <p style="text-align: center;">
    <a href="/volunteer/roles" class="role-link">
      View All Volunteer Roles
    </a>
  </p>

  <Testimonials testimonials={testimonials} />
</BaseLayout>

<style>
  .site-logo {
    height: 5rem;
    width: auto;
  }

  .role-link {
    display: inline-block;
    margin-top: var(--space-lg);
    padding: var(--space-md) var(--space-lg);
    font-size: var(--font-size-h2);
    font-weight: 600;
    color: var(--color-primary);
    text-align: center;
    text-decoration: none;
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-md);
    transition: color var(--transition-fast) ease,
      background-color var(--transition-fast) ease;
  }

  .role-link:hover {
    color: var(--color-text-inverse);
    background-color: var(--color-primary);
  }
</style>
