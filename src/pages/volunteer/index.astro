---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import Hero from "../../components/sections/Hero.astro";
import VolunteerWhy from "../../components/sections/VolunteerWhy.astro";
import VolunteerPhotoStrip from "../../components/sections/VolunteerPhotoStrip.astro";
import ApplySplit from "../../components/sections/ApplySplit.astro";
import VolunteerPortalBanner from "../../components/sections/VolunteerPortalBanner.astro";
// import Testimonials from "../../components/sections/Testimonials.astro";

import { siteName, siteDescription, logo, flat_logo, navItems } from "../../config/site";
import { hero, why, apply, portal, photos /*, testimonials */ } from "../../data/volunteer";
---

<BaseLayout
  title="Volunteer at Our Free Clinic"
  description="Volunteer with Bingham Family Clinic in Orem, UT — join our team as a volunteer or clinical provider helping Utah County families get free care."
  siteName={siteName}
>
  <Header navItems={navItems} slot="header">
    <a slot="logo" href="/" aria-label={`${siteName} home`}>
      <img src={flat_logo.src} alt={flat_logo.alt} class="site-logo" />
    </a>
  </Header>

  <Hero
    backgroundImage={hero.backgroundImage}
    heading={hero.heading}
    subheading={hero.subheading}
  />

  <VolunteerWhy
    image={why.image}
    heading={why.heading}
    benefits={why.benefits}
    ctaText={why.ctaText}
    ctaHref={why.ctaHref}
  />

  <VolunteerPhotoStrip photos={photos} />

  <ApplySplit heading={apply.heading} subheading={apply.subheading} options={apply.options} />

  <section class="roles-cta">
    <div class="roles-cta__inner">
      <p class="roles-cta__kicker">Still exploring?</p>
      <h2 class="roles-cta__heading">See every volunteer role we offer</h2>
      <p class="roles-cta__subheading">
        From patient-facing positions to behind-the-scenes support, browse the
        full list of roles and find the one that fits you best.
      </p>
      <a href="/volunteer/roles" class="button button--primary roles-cta__button">
        View All Volunteer Roles
      </a>
    </div>
  </section>
  <VolunteerPortalBanner
    heading={portal.heading}
    subheading={portal.subheading}
    ctaText={portal.ctaText}
    ctaHref={portal.ctaHref}
  />

  <!-- <Testimonials testimonials={testimonials} /> -->

  <Footer navItems={navItems} slot="footer" />
</BaseLayout>

<style>
  .site-logo {
    height: 5rem;
    width: auto;
  }

  .roles-cta {
    padding: var(--space-2xl) var(--space-lg);
    background-color: var(--color-surface, #f7f7f5);
    border-block: 1px solid var(--color-border);
  }

  .roles-cta__inner {
    max-width: 34rem;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
  }

  .roles-cta__kicker {
    font-size: var(--font-size-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    margin: 0;
  }

  .roles-cta__heading {
    font-size: var(--font-size-h3);
    font-weight: 700;
    margin: 0;
  }

  .roles-cta__subheading {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 var(--space-sm);
  }

  .roles-cta__button {
    margin-top: var(--space-2xs);
  }
</style>
