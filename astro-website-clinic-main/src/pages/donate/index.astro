---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import DonateHero from "../../components/sections/DonateHero.astro";
import DonateOptions from "../../components/sections/DonateOptions.astro";
import Mission from "../../components/sections/Mission.astro";

import { siteName, siteDescription, logo, flat_logo, navItems } from "../../config/site";
import { hero, options, venmo } from "../../data/donate";
import { mission } from "../../data/home";
---

<BaseLayout
  title="Donate"
  description="Support Bingham Family Clinic — donate online through Clover, by wire transfer, or with Venmo."
  siteName={siteName}
>
  <Header navItems={navItems} slot="header">
    <a slot="logo" href="/" aria-label={`${siteName} home`}>
      <img src={flat_logo.src} alt={flat_logo.alt} class="site-logo" />
    </a>
  </Header>

  <DonateHero heading={hero.heading} quote={hero.quote} />

  <DonateOptions options={options} venmo={venmo} />

  <Mission
    backgroundImage={mission.backgroundImage}
    heading={mission.heading}
    statement={mission.statement}
    tagline={mission.tagline}
  />

  <Footer navItems={navItems} slot="footer" />
</BaseLayout>

<style>
  .site-logo {
    height: 5rem;
    width: auto;
  }
</style>
