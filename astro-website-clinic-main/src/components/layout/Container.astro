---
/**
 * Container
 * Centers content and applies consistent max-width and responsive
 * horizontal padding. Use inside sections to constrain content width.
 */

interface Props {
  /** Use the narrower content max-width, e.g. for text-heavy sections. */
  narrow?: boolean;
  /** Element tag to render. */
  as?: keyof HTMLElementTagNameMap;
}

const { narrow = false, as: Tag = "div" }: Props = Astro.props;
---

<Tag class:list={["container", { "container--narrow": narrow }]}>
  <slot />
</Tag>