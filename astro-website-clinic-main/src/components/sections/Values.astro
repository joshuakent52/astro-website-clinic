---
import Section from "../ui/Section.astro";
import type { Value } from "../../data/about";

/**
 * Values
 * Centered "divider" heading (rule / title / rule) followed by a single
 * stacked column of icon + title + description rows. Used at the bottom
 * of the about page to list the clinic's core values.
 */

interface Props {
  heading: string;
  items: Value[];
}

const { heading, items } = Astro.props;

const icons: Record<Value["icon"], string> = {
  accessible: '<circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/>',
  cooperative: '<circle cx="9" cy="12" r="5"/><circle cx="15" cy="12" r="5"/>',
  dignified: '<path d="M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3Z"/>',
  efficient: '<path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z"/>',
  education:
    '<path d="M2 9 12 4l10 5-10 5-10-5Z"/><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/>',
  legacy: '<path d="M3 21h18"/><path d="M5 21V9l7-5 7 5v12"/><path d="M9 21v-6h6v6"/>',
  replicable:
    '<rect x="9" y="9" width="10" height="10" rx="1.5"/><path d="M5 15V6a1.5 1.5 0 0 1 1.5-1.5H15"/>',
  sustainable:
    '<path d="M12 22V12"/><path d="M12 12C6 12 4 8 4 4c6 0 8 3 8 8Z"/><path d="M12 12c0-5 2-8 8-8 0 4-2 8-8 8Z"/>',
  service:
    '<path d="M12 21s-6.5-4-9-8.5C1.4 9.4 3 6 6.4 6 8.5 6 10 7.1 12 10c2-2.9 3.5-4 5.6-4 3.4 0 5 3.4 3.4 6.5C18.5 17 12 21 12 21Z"/>',
  visible:
    '<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>',
};
---

<Section narrow background="surface">
  <div class="values__heading">
    <hr />
    <h2>{heading}</h2>
    <hr />
  </div>

  <ul class="values__list">
    {
      items.map((item) => (
        <li class="values__item">
          <span class="values__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.icon]} />
          </span>
          <div class="values__content">
            <h3>{item.title}</h3>
            <p class="text-muted">{item.description}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .values__heading {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .values__heading hr {
    flex: 1;
    border: none;
    border-top: 1px solid var(--color-border);
  }

  .values__heading h2 {
    margin: 0;
    white-space: nowrap;
  }

  .values__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .values__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .values__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-full);
    background-color: var(--color-surface-muted);
    color: var(--color-primary);
  }

  .values__icon svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .values__content h3 {
    color: var(--color-primary);
    margin-bottom: var(--space-2xs);
  }

  .values__content p {
    margin: 0;
  }

  @media (max-width: 768px) {
    .values__heading {
      gap: var(--space-md);
    }

    .values__heading h2 {
      font-size: var(--font-size-h3);
      white-space: normal;
      text-align: center;
    }
  }
</style>
